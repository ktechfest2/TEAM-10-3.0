# Postgres connection string (local: unix socket; production: Neon)
DATABASE_URL=postgres:///tally?host=/var/run/postgresql
# AI Gateway key (or use `vercel env pull` for OIDC)
AI_GATEWAY_API_KEY=
# Model used for EC8A reading and claim extraction
TALLY_MODEL=google/gemini-2.5-flash-lite
# Secret pepper for hashing phone numbers
PHONE_PEPPER=
# Shared secret for the scheduled anchoring job
ANCHOR_CRON_SECRET=
# Operator code for /ops (simulation, reset). Unset in production disables it
OPS_CODE=
# Invite code for official roles (officer, agent, observer, collation)
TALLY_INVITE_CODE=
# SMS alerts via Africa's Talking (username "sandbox" for their free simulator). Unset: alerts are saved and shown in the app only
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Public address used in text messages (defaults to the Vercel production host)
PUBLIC_URL=
